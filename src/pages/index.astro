---
import "@/home/styles.css";
import About from "@/home/About.vue";
import Background from "@/home/Background.vue";
import Footer from "@/home/components/Footer.vue";
import Header from "@/home/components/Header.vue";
import Contact from "@/home/Contact.vue";
import Extras from "@/home/Extras.vue";
import Follow from "@/home/Follow.vue";
import Highlights from "@/home/Highlights.vue";
import Listen from "@/home/Listen.vue";
import Splash from "@/home/Splash.vue";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Vincent Rubinetti" description="Composer · Producer">
  <Background
    client:only="vue"
    class="fixed inset-0 -z-10 size-full bg-black"
  />
  <Splash client:load />
  <Header />
  <main>
    <Listen client:load />
    <Follow />
    <Highlights client:visible />
    <About />
    <Extras />
    <Contact client:load />
  </main>
  <Footer />
</Layout>
