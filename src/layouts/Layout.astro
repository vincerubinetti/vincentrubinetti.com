---
import "@fontsource-variable/aleo";
import "@fontsource-variable/outfit";

export type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="0ff809f6-188d-4d44-8e7d-681e16ecb620"></script>

    <script src="./links.ts"></script>
    <script src="./headings.ts"></script>
    <script src="./aria.ts"></script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/icon.svg" />

    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://vincentrubinetti.com" />
    <meta property="og:image" content="share.png" />
    <meta property="og:type" content="website" />
  </head>

  <body>
    <!-- breakpoint debug -->
    {
      import.meta.env.DEV && (
        <div class="fixed top-6 right-0 z-100 grid place-content-center bg-black p-2 font-sans text-white">
          <div class="xs:hidden">XS</div>
          <div class="max-xs:hidden sm:hidden">SM</div>
          <div class="max-sm:hidden md:hidden">MD</div>
          <div class="max-md:hidden lg:hidden">LG</div>
          <div class="max-lg:hidden xl:hidden">XL</div>
        </div>
      )
    }

    <slot />
  </body>
</html>
