{
  "plugins": [
    "prettier-plugin-astro",
    "prettier-plugin-tailwindcss",
    "@ianvs/prettier-plugin-sort-imports"
  ],
  "tailwindStylesheet": "./src/styles.css",
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    },
    {
      "files": "*.!(css)",
      "options": {
        "importOrder": [
          "<TYPES>^vue",
          "<TYPES>^@[a-zA-Z]",
          "<TYPES>^[a-zA-Z]",
          "<TYPES>^@/",
          "<TYPES>^/",
          "<TYPES>^./",
          "<TYPES>^../",
          "<TYPES>",
          "^vue",
          "^@[a-zA-Z]",
          "^[a-zA-Z]",
          "^@/",
          "^/",
          "^./",
          "^../"
        ],
        "importOrderParserPlugins": ["typescript", "importAssertions"],
        "htmlWhitespaceSensitivity": "strict"
      }
    }
  ]
}
